* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    color: #4b2633;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 20px;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 15% 20%,
            #ffffff 0%,
            transparent 25%
        ),
        radial-gradient(
            circle at 85% 80%,
            #ffd6e8 0%,
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #fff0f6,
            #fff1ec,
            #f8e8ff
        );
}


/* Floating background hearts */

body::before,
body::after {
    content: "💗";

    position: fixed;

    font-size: 90px;

    opacity: 0.12;

    pointer-events: none;

    animation: floatingHeart 7s ease-in-out infinite;
}

body::before {
    left: 7%;
    top: 8%;
}

body::after {
    right: 7%;
    bottom: 8%;

    animation-delay: 2s;
}


@keyframes floatingHeart {

    0%,
    100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-18px) rotate(8deg);
    }
}


/* Main container */

.container {
    width: min(620px, 100%);

    position: relative;

    z-index: 1;
}


/* Pages */

.page {
    display: none;
}

.page.active {
    display: block;

    animation: pageEnter 0.5s ease;
}


@keyframes pageEnter {

    from {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* Card */

.card {
    background: rgba(255, 255, 255, 0.78);

    backdrop-filter: blur(14px);

    border: 1px solid rgba(255, 255, 255, 0.9);

    border-radius: 28px;

    padding: 40px 30px;

    text-align: center;

    box-shadow:
        0 18px 55px rgba(143, 72, 105, 0.15);
}


/* Emojis */

.emoji {
    font-size: 54px;

    margin-bottom: 15px;
}

.emoji.big {
    font-size: 72px;
}


/* Headings */

h1 {
    font-size: clamp(28px, 6vw, 42px);

    margin-bottom: 18px;

    color: #b64268;
}


/* Text */

p {
    font-size: 18px;

    line-height: 1.7;

    margin: 10px 0;
}

.special {
    font-size: 21px;

    font-weight: 700;

    color: #b64268;
}

.signature {
    margin-top: 24px;

    font-style: italic;
}

.small {
    font-size: 14px;

    opacity: 0.65;
}


/* Buttons */

button {
    border: none;

    border-radius: 999px;

    padding: 13px 23px;

    margin-top: 22px;

    font-size: 16px;

    font-weight: 700;

    cursor: pointer;

    color: white;

    background: #ff8fb5;

    box-shadow:
        0 8px 18px rgba(255, 111, 160, 0.22);

    transition:
        transform 0.2s ease,
        background 0.2s ease;
}

button:hover {
    transform: translateY(-2px);

    background: #f579a3;
}

button:active {
    transform: scale(0.97);
}


/* Button group */

.buttons {
    display: flex;

    justify-content: center;

    align-items: center;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 8px;
}

.buttons button {
    margin-top: 0;
}


/* Secondary button */

button.secondary {
    background: #f5d9e4;

    color: #8d4962;
}

button.secondary:hover {
    background: #ecc8d7;
}


/* Wrong answer */

#answer {
    min-height: 28px;

    margin-top: 18px;

    font-weight: 700;

    color: #b64268;
}


/* Final page */

.final-card {
    padding-top: 45px;
    padding-bottom: 45px;
}

.final {
    font-size: 22px;

    line-height: 1.8;
}


/* Mobile */

@media (max-width: 600px) {

    body {
        padding: 14px;
    }

    .card {
        padding: 32px 22px;

        border-radius: 24px;
    }

    .emoji.big {
        font-size: 60px;
    }

    p {
        font-size: 17px;
    }

    .special {
        font-size: 19px;
    }

    button {
        font-size: 15px;

        padding: 12px 20px;
    }
}
